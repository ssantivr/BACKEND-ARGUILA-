DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/arquila
UPLOAD_DIR=uploads
COOKIE_SECURE=0
# Optional: DEBUG, INFO, WARNING or ERROR. Default: INFO
LOG_LEVEL=
# Uses Claude as the AI assistant. Never commit a real key.
# Without it the assistant uses a local Ollama model, and fixed rules if Ollama is not running.
ANTHROPIC_API_KEY=
# Optional: local model and Ollama address. Defaults: first installed model, http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_URL=
APP_URL=http://localhost:5173
# Optional: comma-separated origins allowed to call the API from a browser. Default: APP_URL
CORS_ORIGINS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@arquila.local
